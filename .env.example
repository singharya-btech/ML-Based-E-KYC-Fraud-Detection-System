# Copy values into your deployment secret manager. Never commit real credentials.
DIGIO_ENV=sandbox
DIGIO_CLIENT_ID=replace-with-digio-sandbox-client-id
DIGIO_CLIENT_SECRET=replace-with-digio-sandbox-client-secret
DIGIO_TEMPLATE_PAN=replace-with-your-digistudio-pan-template-name
DIGIO_TEMPLATE_AADHAAR=replace-with-your-digistudio-aadhaar-template-name
DIGIO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
APP_API_TOKEN=replace-with-a-random-shared-server-token
KYC_API_URL=http://127.0.0.1:8000
KYC_SESSION_DB_PATH=data/kyc_sessions.sqlite3
